{
  "plugins": [
    {
      "id": "source",
      "role": "input",
      "bin": "input-file",
      "streams": [
        {
          "id": "logs",
          "description": "example.log 新增内容"
        }
      ],
      "config": {
        "path": "example.log",
        "mode": "follow"
      }
    },
    {
      "id": "screen",
      "role": "output",
      "bin": "output-raw",
      "autostart": false,
      "reads": [
        "logs"
      ],
      "config": {}
    }
  ]
}
