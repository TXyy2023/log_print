{
  "plugins": [
    {
      "id": "source",
      "bin": "input-file",
      "streams": [
        {
          "id": "source"
        }
      ],
      "config": {
        "path": "project/plugins/outputs/output-file/examples/source.log",
        "mode": "static"
      },
      "role": "input"
    },
    {
      "id": "archive",
      "bin": "output-file",
      "reads": [
        "source"
      ],
      "config": {
        "streams": [
          "source"
        ],
        "mode": "create",
        "fail_on_gap": true,
        "sqlite": {
          "path": "capture/sqlite/records.sqlite"
        }
      },
      "role": "output"
    }
  ]
}
